QWidget {
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    color: #2b2b2b;
}

#CentralWidget {
    background-color: #f8f9fa;
}

#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e9ecef;
}

#LogoLabel {
    font-family: "Poppins", "Inter";
    font-size: 24px;
    font-weight: bold;
    color: #1c2d3d;
    padding-left: 8px;
}

QPushButton[cssClass="NavButton"] {
    text-align: left;
    padding: 11px 16px;
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: #495057;
    font-size: 14px;
    font-weight: 500;
}

QPushButton[cssClass="NavButton"]:hover {
    background-color: #f1f3f5;
}

QPushButton[cssClass="NavButton"][active="true"] {
    background-color: #4a7c9b;
    color: #ffffff;
    font-weight: 600;
}

QFrame[cssClass="Card"] {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #f0f2f5;
}

QLabel[cssClass="CardTitle"] {
    font-size: 14px;
    color: #495057;
    font-weight: 500;
}

QLabel[cssClass="SectionTitle"] {
    font-size: 16px;
    color: #212529;
    font-weight: 600;
}

#Breadcrumb {
    font-size: 15px;
}

#ActionBtnBlue {
    background-color: #4a7c9b;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
}

#ActionBtnBlue:hover {
    background-color: #3b6680;
}

#ActionBtnGreen {
    background-color: #2e9f63;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
}

#ActionBtnGreen:hover {
    background-color: #258552;
}

QTableWidget {
    background-color: #ffffff;
    border: none;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #e2e5e9;
    color: #5c646d;
    font-weight: 600;
    font-size: 12px;
    border: none;
    padding: 10px 8px;
    text-align: left;
}

QTableWidget::item {
    border-bottom: 1px solid #f1f3f5;
    padding-left: 8px;
}